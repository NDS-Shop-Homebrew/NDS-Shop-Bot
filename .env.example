# ==============================================================================
# NDS-Shop-Bot - Variables d'environnement
# Copie ce fichier en .env à la racine du bot
# ==============================================================================

# Environnement
NODE_ENV=production

# Port du serveur (dashboard)
PORT=3004

# URL du site public
SITE_URL="https://db-nds-shop.fr"

# ------------- Better Auth -------------
# URL d'accès à ce dashboard (bot)
BETTER_AUTH_URL="https://bot.db-nds-shop.fr"
# GÉNÉRER DIFFÉREMMENT d'upload: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32_UNIQUE"

# ------------- DATABASE (MySQL) -------------
DATABASE_URL="mysql://ndsshop:CHANGE_ME_mdp@mysql:3306/ndsshop"

# ------------- Discord Bot -------------
DISCORD_TOKEN="CHANGE_ME_token_du_bot"
DISCORD_OAUTH_CLIENT_ID="CHANGE_ME"
DISCORD_OAUTH_CLIENT_SECRET="CHANGE_ME"
DISCORD_GUILD_ID="1271186486070345843"
# ID du message de menu de rôles (optionnel)
ROLE_MENU_MESSAGE_ID="1537949447206736013"

# URL de l'API interne du site (Docker: http://site-backend:3001)
API_BASE_URL="http://site-backend:3001"
