// Schéma Prisma du bot NDS-Shop — MÊME base de données que upload.db-nds-shop.fr.
// Les tables User/Session/Account/Verification sont partagées (auth identique).
// Les tables bot_* sont définies côté upload (source de vérité) et répliquées ici.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  role            String    @default("member")
  createdAt       DateTime  @default(now())
  name            String    @db.Text
  email           String
  emailVerified   Boolean   @default(false)
  image           String?   @db.Text
  updatedAt       DateTime  @updatedAt
  displayUsername String?   @db.Text
  banned          Boolean?  @default(false)
  banReason       String?   @db.Text
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @db.Text

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model BotAnnouncement {
  id        String    @id @default(cuid())
  title     String    @db.Text
  content   String    @db.Text
  channel   String    @db.Text
  status    String    @default("draft")
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  sentBy    String?   @db.Text

  @@map("bot_announcement")
}

model BotSetting {
  key   String @id
  value String @db.Text

  @@map("bot_setting")
}

model BotLog {
  id        String   @id @default(cuid())
  level     String   @default("info")
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("bot_log")
}

model Ticket {
  id         String          @id @default(cuid())
  userId     String          @db.Text
  username   String?         @db.Text
  category   String          @db.Text
  threadId   String?         @db.Text
  status     String          @default("open")
  createdAt  DateTime        @default(now())
  closedAt   DateTime?
  messages   TicketMessage[]

  @@map("bot_ticket")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String   @db.Text
  author    String   @db.Text
  content   String   @db.Text
  direction String   @default("user")
  createdAt DateTime @default(now())

  @@map("bot_ticket_message")
}

model UserProfile {
  id           String    @id @default(cuid())
  discordId    String    @unique
  xp           BigInt    @default(0)
  level        Int       @default(1)
  favorites    String?   @db.Text
  watched      String?   @db.Text
  lastXpAt     DateTime?
  totalMsgs    Int       @default(0)
  badge        String?   @db.Text
  updatedAt    DateTime  @updatedAt

  @@map("bot_user_profile")
}

model GameSub {
  id        String @id @default(cuid())
  discordId String @unique
  games     String @db.Text

  @@map("bot_game_sub")
}

model Reminder {
  id        String    @id @default(cuid())
  discordId String    @db.Text
  content   String    @db.Text
  channelId String?   @db.Text
  dueAt     DateTime
  sent      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@map("bot_reminder")
}

model BotCommandLog {
  id        String    @id @default(cuid())
  userId    String    @db.Text
  username  String?   @db.Text
  command   String    @db.Text
  options   String?   @db.Text
  createdAt DateTime  @default(now())

  @@map("bot_command_log")
}

model Blacklist {
  id        String    @id @default(cuid())
  discordId String    @unique
  reason    String?   @db.Text
  createdAt DateTime  @default(now())

  @@map("bot_blacklist")
}

model Warn {
  id        String    @id @default(cuid())
  discordId String    @db.Text
  modId     String?   @db.Text
  reason    String?   @db.Text
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("bot_warn")
}

model BotDmContact {
  id          String         @id @default(cuid())
  discordId   String         @unique
  username    String         @db.Text
  lastMessage String?        @db.Text
  lastAt      DateTime       @default(now())
  unreadCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    BotDmMessage[]

  @@map("bot_dm_contact")
}

model BotDmMessage {
  id        String   @id @default(cuid())
  contactId String
  contact   BotDmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction String   @default("user") // user | staff
  authorId  String   @db.Text
  author    String   @db.Text
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@map("bot_dm_message")
}

// Mapping post de demande de jeu (forum #game-requests) → demandeur Discord.
// Rempli au threadCreate par le bot (le backend inscrit le discordId dans l'embed du post).
model GameRequest {
  id        String   @id @default(cuid())
  threadId  String   @unique @db.VarChar(32) // ID du post forum
  discordId String   @db.VarChar(32)         // demandeur
  title     String   @db.Text                // titre demandé
  tagId     String?  @db.VarChar(32)         // tag appliqué (id Discord)
  status    String   @default("Demandé")
  createdAt DateTime @default(now())

  @@map("bot_game_request")
}
